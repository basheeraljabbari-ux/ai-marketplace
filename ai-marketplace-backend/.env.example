DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_marketplace
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-to-a-random-secret

# AI_PROVIDER=mock -> بيانات وهمية للتطوير بدون تكلفة
# AI_PROVIDER=anthropic -> يحتاج AI_API_KEY فعلي (مفتاح Anthropic API)
AI_PROVIDER=mock
AI_API_KEY=

SEARCH_PROVIDER=postgres

# S3-compatible storage (AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_BUCKET=ai-marketplace-images
# endpoint الـ API للرفع فقط — خاص وغير قابل للتصفح عام
STORAGE_ENDPOINT_URL=
# الرابط العام للقراءة. لازم يُضبط مع R2 (buckets خاصة افتراضياً)، وإلا الروابط
# المرجّعة ما تفتح من برّا وترجع 400 لأي جهة خارجية تجيب الصورة (مثل Claude vision).
# مثال R2: https://pub-xxxxxxxx.r2.dev  (بدون اسم الـ bucket)
# لو فاضي: نرجع للصيغة القديمة STORAGE_ENDPOINT_URL/bucket/key
STORAGE_PUBLIC_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
